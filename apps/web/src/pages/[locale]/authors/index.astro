---
import { Heading } from '$lib/components/ui/heading'
import { AuthorCard } from '$lib/components/sections'
import { isLocale } from '@poetry/i18n'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import EmptyState from '../../../components/EmptyState.astro'
import { authorCards, getPoemCounts, getPublishedAuthors } from '../../../lib/cms'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const o = { locale }
const [authors, counts] = await Promise.all([getPublishedAuthors(locale), getPoemCounts()])
const collator = new Intl.Collator(locale)
const cards = (await authorCards(authors, locale, counts)).sort((a, b) => collator.compare(a.name, b.name))
const title = m.authors_title({}, o)
const description = m.authors_intro({}, o)
---

<BaseLayout {locale} title={`${title} · ${m.site_title({}, o)}`} {description} canonicalPath="authors">
  <section>
    <Heading level={1} class="page-title">{title}</Heading>
    {cards.length ? (
      <>
        <p class="collection-intro">{description}</p>
        <p class="collection-count">{m.authors_count({ count: cards.length }, o)}</p>
        <ul class="author-cards">{cards.map(({ id, ...card }) => <li><AuthorCard {...card} {locale} /></li>)}</ul>
      </>
    ) : (
      <EmptyState {locale} message={m.home_no_authors({}, o)} illustration="stage" />
    )}
  </section>
</BaseLayout>
