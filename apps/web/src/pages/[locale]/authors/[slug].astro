---
import { ArrowLeft, ArrowRight, MapPin } from 'lucide-svelte'
import { Heading } from '$lib/components/ui/heading'
import { Link } from '$lib/components/ui/link'
import * as Card from '$lib/components/ui/card'
import { PoemCard } from '$lib/components/sections'
import { isLocale, localizedPath, recordPath, type Locale } from '@poetry/i18n'
import EditorialImage from '../../../components/EditorialImage.astro'
import { authorNames, getAuthor, getAuthorPoemTeasers } from '../../../lib/cms'
import { mediaObject } from '../../../lib/homepage'
import { authorPlace } from '../../../lib/poems'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale, slug } = Astro.params
if (!isLocale(rawLocale) || !slug) return new Response('Not found', { status: 404 })
const locale = rawLocale
const o = { locale }
const author = await getAuthor(slug, locale)
if (!author) return new Response('Not found', { status: 404 })
const [names, poems] = await Promise.all([authorNames([author], locale), getAuthorPoemTeasers(author.id, locale)])
const { name, lang } = names.get(author.id)!
// Never a generated face: without an upload there is no image at all.
const portrait = mediaObject(author.portrait)?.url ? author.portrait : null
const awards = [...(author.awards ?? [])].sort((a, b) => b.year - a.year)
const localePath = (target: Locale) => recordPath('authors', author.slug, target)
---

<BaseLayout {locale} title={`${name} · ${m.site_title({}, o)}`} description={author.biography || undefined} canonicalPath={localePath(locale)} {localePath} contentType="website">
  <Link variant="standalone" class="back-link" href={localizedPath(locale, 'authors')}><ArrowLeft class="flip-rtl" aria-hidden="true" />{m.authors_all({}, o)}</Link>
  <header class:list={['author-head', { 'has-portrait': portrait }]}>
    <div>
      <Heading level={1} class="page-title" {lang}>{name}</Heading>
      <p class="author-place"><MapPin aria-hidden="true" />{authorPlace(author, locale)}</p>
    </div>
    {portrait && <EditorialImage image={portrait} {locale} context="portrait" eager />}
  </header>
  {(author.biography || awards.length > 0) && (
    <div class:list={['author-body', { 'has-awards': awards.length }]}>
      {author.biography && <p class="author-bio">{author.biography}</p>}
      {awards.length > 0 && (
        <Card.Root as="section" size="sm" aria-labelledby="author-awards">
          <Card.Header><Card.Title id="author-awards" level={2}>{m.author_awards({}, o)}</Card.Title></Card.Header>
          <Card.Content>
            <ul class="awards">{awards.map((award) => <li><bdi class="award-year">{award.year}</bdi><span>{award.name}</span></li>)}</ul>
          </Card.Content>
        </Card.Root>
      )}
    </div>
  )}
  {poems.length ? (
    <section aria-labelledby="author-poems">
      <Heading level={2} variant="title" class="author-poems-title" id="author-poems">{m.author_poems({}, o)} <small>{poems.length}</small></Heading>
      <ul class="poem-cards">{poems.map((poem) => <li><PoemCard {poem} {locale} level={3} /></li>)}</ul>
    </section>
  ) : (
    <div class="author-no-poems">
      <p>{m.author_no_poems({ name }, o)}</p>
      <Link variant="standalone" href={localizedPath(locale, 'poems')}>{m.poems_discover({}, o)}<ArrowRight class="flip-rtl" aria-hidden="true" /></Link>
    </div>
  )}
</BaseLayout>

<style>
  .author-head { display: grid; gap: var(--space-sm); margin-block: var(--space-sm) var(--space-lg); overflow-wrap: anywhere; }
  .author-head :global(.page-title) { margin: 0; }
  .author-head :global(figure) { inline-size: 9rem; }
  .author-place { display: flex; align-items: center; gap: var(--space-3xs); margin: var(--space-2xs) 0 0; }
  .author-place :global(svg) { flex: none; inline-size: 1.15em; block-size: 1.15em; }
  .author-body { display: grid; gap: var(--space-lg); }
  .author-bio { margin: 0; max-inline-size: 34em; font-family: var(--font-serif); font-size: var(--font-size-md); line-height: var(--verse-line-height); white-space: pre-line; }
  .awards { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .awards li { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; padding-block: var(--space-2xs); border-block-start: 1px solid var(--border); }
  .award-year { font-weight: 700; }
  section :global(.author-poems-title) { margin-block: var(--space-xl) var(--space-sm); }
  :global(.author-poems-title) small { margin-inline-start: var(--space-2xs); font-family: var(--font-sans); font-size: var(--font-size-base); color: var(--muted-foreground); }
  .author-no-poems { display: grid; justify-items: start; gap: var(--space-2xs); max-inline-size: 40rem; margin-block-start: var(--space-xl); padding: var(--space-md); background: var(--muted); border-radius: var(--panel-radius); corner-shape: squircle; }
  .author-no-poems p { margin: 0; font-family: var(--font-serif); font-size: var(--font-size-md); }
  @media (min-width: 44rem) {
    .author-head.has-portrait { grid-template-columns: minmax(0, 1fr) 14rem; align-items: end; }
    .author-head :global(figure) { inline-size: 100%; }
  }
  @media (min-width: 52rem) {
    .author-body.has-awards { grid-template-columns: minmax(0, 1fr) 20rem; column-gap: var(--space-xl); align-items: start; }
  }
</style>
