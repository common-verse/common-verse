---
import { getSecret } from 'astro:env/server'
import { isLocale } from '@poetry/i18n'
import type { Author, Poem } from '@poetry/types'
import BaseLayout from '../../layouts/BaseLayout.astro'
import HomeFeature from '../../components/HomeFeature.astro'
import HomeSections from '../../components/HomeSections.astro'
import { authorCards, getHomepage, getPoemCounts, getPublishedAuthors, getRecentPoems, getUpcomingEvents, poemTeasers, poemVersions } from '../../lib/cms'
import { featuredItem, mediaObject, sectionItems } from '../../lib/homepage'
import * as m from '../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const suppliedSecret = Astro.url.searchParams.get('previewSecret')
const previewSecret = getSecret('PREVIEW_SECRET')
const preview = Boolean(suppliedSecret && previewSecret && suppliedSecret === previewSecret)
if (suppliedSecret !== null && !preview) return new Response('Invalid preview link', { status: 401 })
const homepageResult = await Promise.allSettled([getHomepage(locale, preview ? suppliedSecret! : undefined)])
const homepage = homepageResult[0].status === 'fulfilled' ? homepageResult[0].value : null
const sections = homepage?.sections ?? []
const visible = sections.filter((section) => section.enabled !== false)
const authorSections = visible.filter((section) => section.blockType === 'authors')
const result = await Promise.allSettled([
  authorSections.length || visible.some((section) => section.item?.relationTo === 'authors') ? getPoemCounts() : Promise.resolve(new Map<number, number>()),
  authorSections.some((section) => section.selectionMode === 'auto' || (!section.selectionMode && !section.authors?.length)) ? getPublishedAuthors(locale, '-createdAt') : Promise.resolve([]),
  visible.some((section) => section.blockType === 'events' && section.selectionMode !== 'manual') ? getUpcomingEvents(locale) : Promise.resolve([]),
  visible.some((section) => section.blockType === 'poems' && section.selectionMode !== 'manual') ? getRecentPoems(locale) : Promise.resolve([]),
])
const counts = result[0].status === 'fulfilled' ? result[0].value : new Map<number, number>()
// Automatic: the newest profiles with at least one published poem.
const recentAuthors = (result[1].status === 'fulfilled' ? result[1].value : []).filter((author) => counts.has(author.id)).slice(0, 4)
const events = result[2].status === 'fulfilled' ? result[2].value : []
const recentPoems = result[3].status === 'fulfilled' ? result[3].value : []

// Every poem and author the page shows, resolved once to the version and name it displays.
const feature = homepage?.feature
const heroPoem = feature?.kind === 'poem' && typeof feature.poem === 'object' && feature.poem && (preview || feature.poem._status !== 'draft') ? feature.poem : null
const featured = visible.map((section) => featuredItem(section, preview))
const poems = [
  ...recentPoems,
  ...visible.flatMap((section) => (section.blockType === 'poems' ? sectionItems<Poem>([], section.poems, 'manual', preview) : [])),
  ...featured.flatMap((item) => (item?.kind === 'poem' ? [item.value] : [])),
  ...(heroPoem ? [heroPoem] : []),
]
const authors = [
  ...recentAuthors,
  ...authorSections.flatMap((section) => sectionItems<Author>([], section.authors, 'manual', preview)),
  ...featured.flatMap((item) => (item?.kind === 'author' ? [item.value] : [])),
]
const unique = <T extends { id: number }>(items: T[]) => [...new Map(items.map((item) => [item.id, item])).values()]
const resolved = await Promise.allSettled([
  poemVersions(unique(poems), locale, preview ? suppliedSecret! : undefined).then((shown) => poemTeasers(shown, locale)),
  authorCards(unique(authors), locale, counts),
])
const teasers = new Map((resolved[0].status === 'fulfilled' ? resolved[0].value : []).map((teaser) => [teaser.id, teaser]))
const cards = new Map((resolved[1].status === 'fulfilled' ? resolved[1].value : []).map((card) => [card.id, card]))
const unavailable = [...homepageResult, ...result, ...resolved].some((entry) => entry.status === 'rejected')
if (unavailable) Astro.response.status = 503
const title = homepage?.seo?.title || m.site_title({}, { locale })
const description = homepage?.seo?.description || m.site_description({}, { locale })
const social = mediaObject(homepage?.seo?.image)
const image = social?.url ? new URL(social.url, import.meta.env.PUBLIC_CMS_URL ?? 'http://localhost:3001').href : undefined
const hasUpcoming = sections.some((section) => section.blockType === 'events' && section.enabled !== false)
---

<BaseLayout {locale} {title} {description} {image} {preview} mainClass="homepage">
  {unavailable && <p class="content-unavailable" role="status">{m.home_unavailable({}, { locale })}</p>}
  <HomeFeature {feature} poem={heroPoem ? teasers.get(heroPoem.id) : undefined} {locale} {preview} {hasUpcoming} />
  <HomeSections {sections} {recentAuthors} {recentPoems} {events} {teasers} {cards} {locale} {preview} />
</BaseLayout>
