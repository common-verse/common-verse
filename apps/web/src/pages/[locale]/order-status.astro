---
import { ORDER_LOOKUP_SECRET } from 'astro:env/server'
import { ShieldCheck } from 'lucide-svelte'
import { Button } from '$lib/components/ui/button'
import { Heading } from '$lib/components/ui/heading'
import { Text } from '$lib/components/ui/text'
import { isLocale, localizedPath } from '@poetry/i18n'
import type { OrderLookup } from '@poetry/types'
import OrderLookupForm from '../../components/OrderLookupForm.svelte'
import OrderLayout from '../../components/OrderLayout.astro'
import OrderSteps from '../../components/OrderSteps.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { lookupOrder } from '../../lib/cms'
import { limitedLookup, lookupAttempts, orderSteps, parseLookup, shopEmail, statusLabel, type LookupField } from '../../lib/order'
import { formatCode, normalizeCode } from '../../lib/order-code'
import { formatPrice } from '../../lib/shop'
import * as m from '../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const options = { locale }
const t = (message: (inputs: {}, options: { locale: typeof locale }) => string) => message({}, options)
Astro.response.headers.set('Cache-Control', 'no-store')
const path = localizedPath(locale, 'order-status')

// A link from the confirmation carries the code; the email is never put in a URL.
const linked = normalizeCode(Astro.url.searchParams.get('code'))
let values: Record<LookupField, string> = { code: linked ? formatCode(linked) : '', email: '' }
let errors: Partial<Record<LookupField, 'required' | 'invalid'>> = {}
let problem: 'not_found' | 'too_many' | 'unavailable' | null = null
let order: OrderLookup | null = null
if (Astro.request.method === 'POST') {
  const result = parseLookup(await Astro.request.formData().catch(() => new FormData()))
  if (!result.ok) ({ values, errors } = result)
  else {
    values = { code: formatCode(result.code), email: result.email }
    const secret = ORDER_LOOKUP_SECRET
    const found = await limitedLookup(lookupAttempts, Astro.clientAddress, async () => {
      if (!secret) throw new Error('ORDER_LOOKUP_SECRET is not set')
      return lookupOrder(result.code, result.email, secret)
    })
    if ('order' in found) order = found.order
    else problem = found.problem
  }
}

const lines = (order?.items ?? []).map((item, index) => ({ id: String(index), title: item.title, titleLanguage: null, quantity: item.quantity }))
const title = order ? statusLabel(order.status, locale) : t(m.order_status_title)
// The shop's address sits inside the translated sentence as a link.
const [failedBefore, failedAfter] = m.order_status_failed_text({ email: '\u0000' }, options).split('\u0000')
const [orderBefore, orderAfter] = m.order_status_of({ code: '\u0000' }, options).split('\u0000')
---

<BaseLayout {locale} title={`${title} · ${m.site_title({}, options)}`} canonicalPath="order-status" noIndex mainClass={order ? 'checkout-page' : undefined}>
  {order ? (
    <OrderLayout {locale} {lines} total={order.amount}>
      {order.amount !== null && (
        <dl slot="totals" class="status-total"><dt>{t(m.shop_total)}</dt><dd><bdi class="price">{formatPrice(order.amount, locale)}</bdi></dd></dl>
      )}
      <div class="status-result">
        <div class="status-head">
          <Text variant="small" tone="muted">{orderBefore}<bdi dir="ltr" class="status-code">{formatCode(order.code)}</bdi>{orderAfter}</Text>
          <Heading level={1}>{title}</Heading>
          {order.status === 'cancelled' && <Text class="status-lead">{t(m.order_status_cancelled_text)}</Text>}
          {order.status === 'payment_failed' && <Text class="status-lead">{failedBefore}<a href={`mailto:${shopEmail}`}><bdi>{shopEmail}</bdi></a>{failedAfter}</Text>}
        </div>
        <OrderSteps steps={orderSteps(order.status, order.createdAt, locale)} status={order.status} />
        <div class="status-actions">
          <Button variant="outline" href={localizedPath(locale, 'shop')}>{t(m.shop_continue)}</Button>
          <a class="status-another" href={path}>{t(m.order_status_another)}</a>
        </div>
      </div>
    </OrderLayout>
  ) : (
    <section class="status-lookup">
      <Heading level={1}>{title}</Heading>
      <Text>{t(m.order_status_intro)}</Text>
      <OrderLookupForm client:load {locale} action={path} {values} {errors} {problem} linked={linked !== null} />
      <p class="status-privacy"><ShieldCheck size={16} aria-hidden="true" /><span>{t(m.order_status_privacy)}</span></p>
    </section>
  )}
</BaseLayout>

<style>
  .status-lookup { display: grid; gap: var(--space-sm); max-inline-size: 30rem; margin-inline: auto; }
  .status-lookup :global(h1), .status-lookup :global(.ui-text) { margin: 0; }
  .status-privacy { display: flex; gap: var(--space-2xs); margin: 0; font-size: var(--font-size-sm); color: var(--muted-foreground); }
  .status-privacy :global(svg) { flex: none; margin-block-start: 0.15em; }

  .status-result { display: grid; gap: var(--space-md); }
  .status-head { display: grid; gap: var(--space-2xs); }
  .status-head :global(h1), .status-head :global(.ui-text) { margin: 0; }
  .status-code { font-weight: 600; letter-spacing: 0.04em; }
  /* The result's heading size, so form and result read as one page. */
  .status-lookup :global(h1) { font-size: var(--font-size-lg); }
  .status-head :global(.status-lead) { max-inline-size: 40ch; font-size: 1.0625rem; line-height: 1.45; }
  .status-head :global(.status-lead a), .status-another { font-weight: 600; text-decoration: underline; }
  .status-another { display: inline-flex; align-items: center; min-block-size: 2.75rem; }
  .status-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md); }
  .status-total { display: flex; justify-content: space-between; gap: var(--space-sm); margin: 0; padding-block-start: var(--space-2xs); border-block-start: 1px solid var(--border); font-weight: 700; }
  .status-total dd { margin: 0; }
</style>
