---
import { PUBLIC_STRIPE_PUBLISHABLE_KEY } from 'astro:env/server'
import { Heading } from '$lib/components/ui/heading'
import { Link } from '$lib/components/ui/link'
import { Button } from '$lib/components/ui/button'
import { Text } from '$lib/components/ui/text'
import * as Card from '$lib/components/ui/card'
import { isLocale, localizedPath } from '@poetry/i18n'
import CheckoutForm from '../../../../components/CheckoutForm.svelte'
import PaymentForm from '../../../../components/PaymentForm.svelte'
import ShopTotals from '../../../../components/ShopTotals.svelte'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getCart, getShopSettings, initiatePayment, type PaymentStart } from '../../../../lib/cms'
import type { Notice } from '../../../../lib/notifications'
import {
  cartCookie, cartSignature, cartSubtotal, checkoutCookie, cookieOptions, decodeCart, formatNumber, formatPrice, isLineAvailable, lineProduct, shippingRate, titleAttributes,
} from '../../../../lib/shop'
import { decodeCheckout, parseCheckout, type CheckoutAccess, type CheckoutError, type CheckoutField, type CheckoutValues } from '../../../../lib/checkout'
import * as m from '../../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
Astro.response.headers.set('Cache-Control', 'no-store')
const cartPath = localizedPath(locale, 'shop/cart')
const checkoutPath = localizedPath(locale, 'shop/checkout')
const access = decodeCart(Astro.cookies.get(cartCookie)?.value)
const [cart, settings] = await Promise.all([access ? getCart(access, locale) : null, getShopSettings(locale)])
const items = cart?.items ?? []
if (!access || !items.length || !items.every(isLineAvailable)) return Astro.redirect(cartPath, 303)
const shipping = shippingRate(settings)
const publishableKey = shipping === null ? undefined : PUBLIC_STRIPE_PUBLISHABLE_KEY
const signature = cartSignature(items)
const saved = decodeCheckout(Astro.cookies.get(checkoutCookie)?.value)
const editing = Astro.url.searchParams.has('change')

let values: Partial<CheckoutValues> = saved ? { email: saved.email, ...saved.address } : {}
let errors: Partial<Record<CheckoutField, CheckoutError>> = {}
let tooLong = false
let startError: 'OutOfStock' | 'failed' | null = null
if (Astro.request.method === 'POST' && publishableKey) {
  const form = await Astro.request.formData().catch(() => new FormData())
  const result = parseCheckout(form)
  if (result.ok) {
    values = { email: result.email, ...result.address }
    const started: PaymentStart = await initiatePayment(access, result.email, result.address).catch((error) => {
      console.error(error)
      return { error: 'failed' as const }
    })
    if ('clientSecret' in started) {
      const checkout: CheckoutAccess = { ...started, email: result.email, address: result.address, cart: signature }
      Astro.cookies.set(checkoutCookie, JSON.stringify(checkout), cookieOptions(import.meta.env.PROD, 60 * 60 * 24))
      // Redirect so a reload shows this payment instead of starting another one.
      return Astro.redirect(checkoutPath, 303)
    }
    startError = started.error
  } else {
    ;({ values, errors, tooLong } = result)
  }
}
const payment = Astro.request.method === 'GET' && !editing && saved?.cart === signature ? saved : null

const t = (message: (inputs: {}, options: { locale: typeof locale }) => string) => message({}, { locale })
const notice: Notice | undefined = startError
  ? { tone: 'error', text: startError === 'OutOfStock' ? t(m.shop_out_of_stock) : t(m.shop_start_error), link: startError === 'OutOfStock' ? { href: cartPath, label: t(m.shop_edit_cart) } : undefined }
  : tooLong
    ? { tone: 'error', text: t(m.shop_error_too_long) }
    : Object.keys(errors).length
      ? { tone: 'error', text: t(m.shop_error_summary) }
      : undefined
const stripeLocale = (['de', 'en', 'ar'] as const).find((value) => value === locale) ?? 'en'
const returnUrl = new URL(localizedPath(locale, 'shop/checkout/complete'), import.meta.env.PUBLIC_SITE_URL ?? 'http://localhost:4321').href
const title = t(m.shop_checkout_title)
---

<BaseLayout {locale} title={`${title} · ${m.site_title({}, { locale })}`} canonicalPath="shop/checkout" noIndex alternateLocales={[]} {notice} noticeFocus={Boolean(startError || tooLong)}>
  <Heading level={1}>{title}</Heading>
  <div class="checkout-layout">
    <div class="checkout-main">
      {!publishableKey ? (
        <Text tone="muted">{t(m.shop_payments_unavailable)}</Text>
      ) : payment ? (
        <section class="payment-step" aria-labelledby="payment-heading">
          <Heading level={2} id="payment-heading">{t(m.shop_payment)}</Heading>
          <dl class="ship-to">
            <div><dt>{t(m.shop_email)}</dt><dd><bdi>{payment.email}</bdi></dd></div>
            <div><dt>{t(m.shop_ship_to)}</dt><dd>
              {[[payment.address.firstName, payment.address.lastName].join(' '), payment.address.company, payment.address.addressLine1, payment.address.addressLine2, `${payment.address.postalCode} ${payment.address.city}`, t(m.shop_country_de)]
                .filter(Boolean).map((line) => <bdi>{line}</bdi><br />)}
            </dd></div>
          </dl>
          <PaymentForm client:load clientSecret={payment.clientSecret} {publishableKey} locale={stripeLocale} {returnUrl}
            labels={{ pay: t(m.shop_pay), paying: t(m.shop_paying), loading: t(m.shop_payment_loading), loadError: t(m.shop_payment_load_error), paymentError: t(m.shop_payment_error) }} />
          <noscript><Text tone="muted">{t(m.shop_payment_needs_js)}</Text></noscript>
          <Link href={`${checkoutPath}?change`}>{t(m.shop_change_address)}</Link>
        </section>
      ) : (
        <CheckoutForm client:load action={checkoutPath} {locale} {values} {errors} />
      )}
      <Text variant="small" tone="muted" class="legal">
        {t(m.shop_legal)}
      </Text>
      <ul class="legal-links">
        <li><Link href={localizedPath(locale, 'terms')}>{t(m.home_terms)}</Link></li>
        <li><Link href={localizedPath(locale, 'privacy')}>{t(m.home_privacy)}</Link></li>
      </ul>
    </div>
    <Card.Root as="aside" size="sm" aria-labelledby="order-heading">
      <Card.Header><Card.Title level={2} id="order-heading">{t(m.shop_order_summary)}</Card.Title></Card.Header>
      <Card.Content>
        <ul class="order-lines">
          {items.map((item) => {
            const product = lineProduct(item)
            return (
              <li>
                <span>{product ? <span {...titleAttributes(product)}>{product.title}</span> : t(m.shop_not_available)} <bdi>× {formatNumber(item.quantity, locale)}</bdi></span>
                <bdi class="price">{formatPrice((product?.priceInEUR ?? 0) * item.quantity, locale)}</bdi>
              </li>
            )
          })}
        </ul>
        <ShopTotals {locale} subtotal={cartSubtotal(items)} {shipping} note={settings.priceNote} />
      </Card.Content>
      <Card.Footer><Link variant="standalone" href={cartPath}>{t(m.shop_edit_cart)}</Link></Card.Footer>
    </Card.Root>
  </div>
</BaseLayout>

<style>
  .checkout-layout { display: grid; gap: var(--space-lg); align-items: start; }
  .checkout-main { display: grid; gap: var(--space-md); min-inline-size: 0; }
  .payment-step { display: grid; gap: var(--space-md); }
  .payment-step :global(h2) { margin: 0; }
  .ship-to { display: grid; gap: var(--space-sm); margin: 0; }
  .ship-to dt { font-size: var(--font-size-sm); color: var(--muted-foreground); }
  .ship-to dd { margin: 0; }
  .checkout-main :global(.legal) { margin: 0; max-inline-size: 60ch; }
  .legal-links { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); margin: 0; padding: 0; list-style: none; }
  .order-lines { display: grid; gap: var(--space-xs); margin: 0 0 var(--space-md); padding: 0; list-style: none; }
  .order-lines li { display: flex; justify-content: space-between; gap: var(--space-sm); overflow-wrap: anywhere; }
  @media (min-width: 48rem) {
    .checkout-layout { grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); }
  }
</style>
