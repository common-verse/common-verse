---
import { Heading } from '$lib/components/ui/heading'
import { Link } from '$lib/components/ui/link'
import * as Card from '$lib/components/ui/card'
import { isLocale, localizedPath } from '@poetry/i18n'
import CartLines, { type CartEntry } from '../../../components/CartLines.svelte'
import CartSummary from '../../../components/CartSummary.svelte'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { applyChange, cartStatuses, isSuccess, loadCart, statusMessage, type CartStatus } from '../../../lib/cart-actions'
import { getProductByID } from '../../../lib/cms'
import { parseIdentifier, parseQuantity } from '../../../lib/shop'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const cartPath = localizedPath(locale, 'shop/cart')

// The full cart without JavaScript; the drawer shows the same lines with the same forms.
if (Astro.request.method === 'POST') {
  let result: Awaited<ReturnType<typeof applyChange>> = { status: 'failed' }
  const form = Object.fromEntries(await Astro.request.formData().catch(() => new FormData()))
  try {
    result = await applyChange(Astro.cookies, locale, form)
  } catch (error) {
    console.error(error)
  }
  // The query names no person, only the book; the fragment moves the page and the next Tab to the line.
  const query = new URLSearchParams({ status: result.status })
  let target = ''
  if (result.removed) {
    query.set('product', result.removed.product)
    query.set('quantity', String(result.removed.quantity))
    target = `#undo-${result.removed.product}`
  } else if (result.status === 'added') {
    const product = parseIdentifier(typeof form.product === 'string' ? form.product : null)
    if (product) query.set('product', product)
  } else if (result.status === 'updated') {
    const item = parseIdentifier(typeof form.item === 'string' ? form.item : null)
    if (item) target = `#line-${item}`
  }
  return Astro.redirect(`${cartPath}?${query}${target}`, 303)
}

Astro.response.headers.set('Cache-Control', 'no-store')
const { view } = await loadCart(Astro.cookies, locale)
const params = Astro.url.searchParams
const status = cartStatuses.find((value) => value === params.get('status')) as CartStatus | undefined
// After a removal the page offers to put the book back; its title is looked up by ID.
const removedProduct = status === 'removed' ? parseIdentifier(params.get('product')) : null
const removedQuantity = parseQuantity(params.get('quantity'))
const removed = removedProduct && removedQuantity && !view.lines.some((line) => line.product === removedProduct)
  ? await getProductByID(removedProduct, locale).catch(() => null)
  : null
// A book just added is tinted like in the drawer instead of a notice covering the heading.
const addedProduct = status === 'added' ? parseIdentifier(params.get('product')) : null
const entries: CartEntry[] = [
  ...(removed && removedQuantity ? [{ kind: 'undo' as const, product: removedProduct!, quantity: removedQuantity, title: removed.title, titleLanguage: removed.titleLanguage ?? null }] : []),
  ...view.lines.map((line) => ({ kind: 'line' as const, line, fresh: Boolean(addedProduct) && line.product === addedProduct })),
]
const fresh = entries.some((entry) => entry.kind === 'line' && entry.fresh)
const notice = status && !(status === 'removed' && removed) && !(status === 'added' && fresh)
  ? { tone: isSuccess(status) ? ('success' as const) : ('error' as const), text: statusMessage(status, locale) }
  : undefined
const title = m.shop_cart({}, { locale })
---

<BaseLayout {locale} title={`${title} · ${m.site_title({}, { locale })}`} canonicalPath="shop/cart" noIndex alternateLocales={[]} {notice} noticeFocus={notice?.tone === 'error'} noticeCloseHref={cartPath}>
  <section class="cart">
    <Heading level={1}>{title}</Heading>
    {entries.length > 0 && (
      <div class="cart-layout">
        <CartLines {entries} {locale} action={cartPath} />
        {view.lines.length > 0 && (
          <Card.Root as="aside" size="sm" aria-labelledby="cart-summary-heading">
            <Card.Header><Card.Title level={2} id="cart-summary-heading">{m.shop_order_summary({}, { locale })}</Card.Title></Card.Header>
            <Card.Content><CartSummary {view} {locale} /></Card.Content>
          </Card.Root>
        )}
      </div>
    )}
    {!view.lines.length && (
      <>
        <p class="empty-message">{m.shop_cart_empty({}, { locale })}</p>
        <Link variant="standalone" href={localizedPath(locale, 'shop')}>{m.shop_continue({}, { locale })}</Link>
      </>
    )}
  </section>
</BaseLayout>

<style>
  .cart-layout { display: grid; gap: var(--space-lg); align-items: start; }
  @media (min-width: 48rem) {
    .cart-layout { grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); }
  }
</style>
