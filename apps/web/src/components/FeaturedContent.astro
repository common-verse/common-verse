---
import { localizedPath, recordPath, type Locale } from '@poetry/i18n'
import type { HomepageSection } from '@poetry/types'
import { Heading } from '$lib/components/ui/heading'
import { Link } from '$lib/components/ui/link'
import { AuthorCard, PoemCard } from '$lib/components/sections'
import EditorialImage from './EditorialImage.astro'
import type { AuthorCardData } from '../lib/cms'
import type { PoemTeaser } from '../lib/poems'
import { featuredItem } from '../lib/homepage'
interface Props { section: HomepageSection; teasers: Map<number, PoemTeaser>; cards: Map<number, AuthorCardData>; locale: Locale; preview?: boolean }
const { section, teasers, cards, locale, preview = false } = Astro.props
const item = featuredItem(section, preview)
const poem = item?.kind === 'poem' ? teasers.get(item.value.id) : undefined
const author = item?.kind === 'author' ? cards.get(item.value.id) : undefined
---
{poem && <div class="featured-layout"><PoemCard {poem} {locale} level={3} /></div>}
{item?.kind === 'author' && author && <article class="featured-layout featured-author">
  <AuthorCard {...author} {locale} level={3} />
  {item.value.biography && <p class="section-prose">{item.value.biography}</p>}
</article>}
{item?.kind === 'event' && <article class="featured-layout">
  <EditorialImage image={item.value.image} {locale} />
  <div><Heading level={3}><Link variant="heading" href={localizedPath(locale, recordPath('events', item.value, locale))}>{item.value.title}</Link></Heading>
  <p><time datetime={item.value.startDate}>{new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Berlin' }).format(new Date(item.value.startDate))}</time></p>
  {item.value.description && <p class="section-prose">{item.value.description}</p>}</div>
</article>}
