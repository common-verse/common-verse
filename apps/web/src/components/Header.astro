---
import { localizedPath, unlocalizedPath, type Locale } from '@poetry/i18n'
import { MicVocal, Newspaper, Quote, ShoppingBag, Users } from 'lucide-svelte'
import * as m from '../paraglide/messages.js'
import LanguageSwitcher from './LanguageSwitcher.astro'
import ThemeSwitcher from './ThemeSwitcher.svelte'
import BrandLogo from './BrandLogo.astro'
import PageNotification from './PageNotification.svelte'
import type { Notice } from '../lib/notifications'
import type { ThemePreference } from '../lib/theme'

interface Props {
  locale: Locale
  localePath?: (locale: Locale) => string
  themePreference: ThemePreference
  notice?: Notice
  noticeFocus?: boolean
  noticeCloseHref?: string
}

const { locale, localePath, themePreference, notice, noticeFocus, noticeCloseHref } = Astro.props
const messageOptions = { locale }
const path = unlocalizedPath(Astro.originPathname)
const links = [
  // The bottom bar shows `short` instead of `label` where one is set.
  { route: 'events', label: m.nav_events({}, messageOptions), short: m.nav_events_short({}, messageOptions), Icon: MicVocal },
  // Text lines read in the page direction, so the article icon mirrors.
  { route: 'articles', label: m.nav_articles({}, messageOptions), Icon: Newspaper, flip: true },
  { route: 'poems', label: m.nav_poems({}, messageOptions), Icon: Quote },
  { route: 'authors', label: m.authors_title({}, messageOptions), Icon: Users },
  { route: 'shop', label: m.nav_shop({}, messageOptions), Icon: ShoppingBag },
]
const current = (route: string) => (path === `/${route}` ? 'page' : path.startsWith(`/${route}/`) ? 'true' : undefined)
---

<header class="site-header" style="view-transition-name: site-header">
  <a class="brand" href={localizedPath(locale)}><BrandLogo /><span class="sr-only">The Poetry Project{m.site_title({}, messageOptions) !== 'The Poetry Project' ? ` — ${m.site_title({}, messageOptions)}` : ''}</span></a>
  <nav aria-label={m.nav_primary({}, messageOptions)}>
    {links.map(({ route, label, short, Icon, flip }) => (
      <a href={localizedPath(locale, route)} aria-current={current(route)} style={`--nav-name: nav-${route}`}>
        <Icon class:list={["nav-icon", { "flip-rtl": flip }]} size={24} aria-hidden="true" />
        <span class="nav-label">{label}</span>
        {short && <span class="nav-label-short">{short}</span>}
        {current(route) && <span class="nav-pill"></span>}
      </a>
    ))}
  </nav>
  <div class="header-controls">
    <LanguageSwitcher currentLocale={locale} label={m.language_label({}, messageOptions)} {localePath} path={path} search={Astro.url.search} />
    <ThemeSwitcher client:load preference={themePreference} {locale} />
  </div>
  <PageNotification client:load {locale} {notice} focus={noticeFocus} closeHref={noticeCloseHref} />
</header>
